<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CredentialExplorer.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CredentialExplorer"
    xmlns:core="using:CredentialExplorer.Core">
    <Page.Resources>
        <Style x:Key="ComfortableRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="CompactRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Page.Resources>
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1000" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DetailColumn.Width" Value="360" />
                        <Setter Target="DetailRow.Height" Value="0" />
                        <Setter Target="DetailPanel.(Grid.Row)" Value="0" />
                        <Setter Target="DetailPanel.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <NavigationView x:Name="StoreNavigation"
            AutomationProperties.AutomationId="StoreNavigation"
            PaneDisplayMode="Top" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
            IsPaneToggleButtonVisible="False" SelectionChanged="StoreChanged"
            IsEnabled="{x:Bind ViewModel.IsInteractive, Mode=OneWay}">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="WindowsNavigation"
                    AutomationProperties.AutomationId="WindowsStore"
                    Content="{x:Bind ViewModel.WindowsLabel, Mode=OneWay}" Tag="Windows">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Permissions" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.AutomationId="WebStore"
                    Content="{x:Bind ViewModel.WebLabel, Mode=OneWay}" Tag="Web">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="World" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
        </NavigationView>
        <Grid Grid.Row="1" Padding="24,20,24,16" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="8">
                    <TextBlock AutomationProperties.AutomationId="StoreHeading"
                        Text="{x:Bind ViewModel.Heading, Mode=OneWay}"
                        Style="{StaticResource TitleTextBlockStyle}" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock AutomationProperties.AutomationId="ScopeSummary" TextWrapping="Wrap"
                            Text="{x:Bind ViewModel.ScopeSummary, Mode=OneWay}" VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <HyperlinkButton AutomationProperties.AutomationId="AboutStore" Grid.Column="1"
                        Content="About this store" HorizontalAlignment="Left" Click="ShowAbout">
                        <FlyoutBase.AttachedFlyout>
                            <Flyout x:Name="AboutFlyout">
                                <StackPanel MaxWidth="440" Spacing="12">
                                    <TextBlock Text="About this store" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock AutomationProperties.AutomationId="ScopeText" TextWrapping="Wrap"
                                        Text="{x:Bind ViewModel.ScopeNote, Mode=OneWay}" />
                                    <TextBlock Text="Counts measure returned entries, not capacity. App ownership is never inferred from names. Secrets are never revealed or exported."
                                        TextWrapping="Wrap" />
                                    <Button AutomationProperties.AutomationId="CloseAboutStore"
                                        Content="Got it" HorizontalAlignment="Right" Click="CloseAbout" />
                                </StackPanel>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                        </HyperlinkButton>
                    </Grid>
                </StackPanel>
                <CommandBar AutomationProperties.AutomationId="ViewCommands" Grid.Column="1"
                    Background="{x:Null}" DefaultLabelPosition="Right" IsOpen="True"
                    VerticalAlignment="Top">
                    <AppBarButton AutomationProperties.AutomationId="AppearanceOptions"
                        Icon="Setting" Label="View" IsEnabled="{x:Bind ViewModel.IsInteractive, Mode=OneWay}">
                        <AppBarButton.Flyout>
                            <Flyout x:Name="AppearanceFlyout">
                                <StackPanel MinWidth="240" Spacing="16">
                                    <TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <ComboBox x:Name="ThemePicker" AutomationProperties.AutomationId="ThemePicker"
                                        AutomationProperties.Name="App theme" HorizontalAlignment="Stretch"
                                        Header="Theme" SelectedIndex="0" SelectionChanged="ThemeChanged">
                                        <x:String>System default</x:String>
                                        <x:String>Light</x:String>
                                        <x:String>Dark</x:String>
                                    </ComboBox>
                                    <ComboBox AutomationProperties.AutomationId="DensityPicker"
                                        AutomationProperties.Name="Row density" HorizontalAlignment="Stretch"
                                        Header="Row density"
                                        SelectedIndex="{x:Bind ViewModel.DensityIndex, Mode=TwoWay}">
                                        <x:String>Comfortable</x:String>
                                        <x:String>Compact</x:String>
                                    </ComboBox>
                                    <Button AutomationProperties.AutomationId="CloseAppearance"
                                        Content="Done" HorizontalAlignment="Right" Click="CloseAppearance" />
                                </StackPanel>
                            </Flyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                </CommandBar>
            </Grid>
            <InfoBar Grid.Row="1" AutomationProperties.AutomationId="StoreError"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False"
                Severity="Error" Title="Unable to complete the store operation">
                <TextBlock AutomationProperties.AutomationId="ErrorText"
                    Margin="0,0,0,12" Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}" TextWrapping="Wrap" />
            </InfoBar>
            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox AutomationProperties.AutomationId="CredentialSearch"
                    AutomationProperties.Name="Search credential metadata" VerticalAlignment="Center"
                    PlaceholderText="Search target, username, or type"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    IsEnabled="{x:Bind ViewModel.IsInteractive, Mode=OneWay}" />
                <ComboBox AutomationProperties.AutomationId="CredentialSort"
                    AutomationProperties.Name="Sort credentials" Grid.Column="1"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}"
                    IsEnabled="{x:Bind ViewModel.IsInteractive, Mode=OneWay}">
                    <x:String>Target: A to Z</x:String>
                    <x:String>Target: Z to A</x:String>
                    <x:String>Username</x:String>
                    <x:String>Type</x:String>
                    <x:String>Recently modified</x:String>
                </ComboBox>
                <CommandBar AutomationProperties.AutomationId="StoreCommands" Grid.Column="2"
                    Background="{x:Null}" DefaultLabelPosition="Right" IsOpen="True">
                    <AppBarButton AutomationProperties.AutomationId="RefreshCredentials"
                        Icon="Refresh" Label="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
                </CommandBar>
            </Grid>
            <Grid Grid.Row="3" ColumnSpacing="24" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition x:Name="DetailRow" Height="280" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="DetailColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock AutomationProperties.AutomationId="CredentialCount"
                        AutomationProperties.LiveSetting="Polite"
                        Text="{x:Bind ViewModel.CountText, Mode=OneWay}"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Border Grid.Row="1" Padding="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="16,8,16,0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="132" />
                                    <ColumnDefinition Width="132" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="Target / username" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="2" Text="Type" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="3" Text="Modified" Style="{StaticResource CaptionTextBlockStyle}" />
                            </Grid>
                            <ListView AutomationProperties.AutomationId="CredentialList"
                                AutomationProperties.Name="Credential metadata" Grid.Row="1"
                                ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                                ItemContainerStyle="{x:Bind RowStyle(ViewModel.IsCompact), Mode=OneWay}"
                                ContainerContentChanging="CredentialContainerChanged"
                                ContextRequested="CredentialContextRequested"
                                RightTapped="CredentialRightTapped"
                                IsEnabled="{x:Bind ViewModel.IsInteractive, Mode=OneWay}"
                                SelectionMode="Single" ShowsScrollingPlaceholders="True">
                                <ListView.ContextFlyout>
                                    <MenuFlyout x:Name="RowContextMenu">
                                        <MenuFlyoutItem AutomationProperties.AutomationId="ContextEditUserName"
                                            Text="Edit username..." Icon="Edit" Command="{x:Bind ViewModel.EditUserNameCommand}" />
                                        <MenuFlyoutItem AutomationProperties.AutomationId="ContextRemoveCredential"
                                            Text="Remove entry..." Icon="Delete" Command="{x:Bind ViewModel.RemoveCommand}" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem AutomationProperties.AutomationId="ContextRefresh"
                                            Text="Refresh" Icon="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
                                    </MenuFlyout>
                                </ListView.ContextFlyout>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="core:CredentialMetadata">
                                        <Grid Padding="4" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="132" />
                                                <ColumnDefinition Width="132" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="{x:Bind IconGlyph}" />
                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Target}" TextTrimming="CharacterEllipsis"
                                                    ToolTipService.ToolTip="{x:Bind Target}"
                                                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind DisplayUserName}" TextTrimming="CharacterEllipsis"
                                                    ToolTipService.ToolTip="{x:Bind DisplayUserName}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{x:Bind TypeName}" VerticalAlignment="Center"
                                                TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind TypeName}"
                                                Style="{StaticResource CaptionTextBlockStyle}" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind ModifiedShortText}" VerticalAlignment="Center"
                                                ToolTipService.ToolTip="{x:Bind ModifiedText}"
                                                Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock AutomationProperties.AutomationId="EmptyState" Grid.Row="1"
                                Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" TextWrapping="Wrap"
                                Visibility="{x:Bind local:MainPage.Visible(ViewModel.ShowEmpty), Mode=OneWay}" />
                        </Grid>
                    </Border>
                </Grid>
                <Border x:Name="DetailPanel" Grid.Row="1" Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Entry details" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Grid.Row="1" Text="Select an entry to explore its metadata."
                            TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="{x:Bind local:MainPage.Hidden(ViewModel.HasSelection), Mode=OneWay}" />
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                            Visibility="{x:Bind local:MainPage.Visible(ViewModel.HasSelection), Mode=OneWay}">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Target / resource" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock AutomationProperties.AutomationId="DetailTarget"
                                        Text="{x:Bind ViewModel.DetailTarget, Mode=OneWay}" TextWrapping="Wrap"
                                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Username" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock AutomationProperties.AutomationId="DetailUserName"
                                        Text="{x:Bind ViewModel.DetailUserName, Mode=OneWay}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Type" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock AutomationProperties.AutomationId="DetailType"
                                        Text="{x:Bind ViewModel.DetailType, Mode=OneWay}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Modified (local time)" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock AutomationProperties.AutomationId="DetailModified"
                                        Text="{x:Bind ViewModel.DetailModified, Mode=OneWay}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Persistence" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.DetailPersistence, Mode=OneWay}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock AutomationProperties.AutomationId="DetailEditNote"
                                    Text="{x:Bind ViewModel.DetailEditNote, Mode=OneWay}" TextWrapping="Wrap"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </ScrollViewer>
                        <CommandBar AutomationProperties.AutomationId="EntryCommands" Grid.Row="2"
                            Background="{x:Null}" DefaultLabelPosition="Right" IsOpen="True"
                            HorizontalAlignment="Left">
                            <AppBarButton AutomationProperties.AutomationId="EditUserName"
                                Icon="Edit" Label="Edit username" Command="{x:Bind ViewModel.EditUserNameCommand}" />
                            <AppBarButton AutomationProperties.AutomationId="RemoveCredential"
                                Icon="Delete" Label="Remove" Command="{x:Bind ViewModel.RemoveCommand}" />
                        </CommandBar>
                    </Grid>
                </Border>
            </Grid>
            <Grid Grid.Row="4" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ProgressRing Width="20" Height="20"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Visibility="{x:Bind local:MainPage.Visible(ViewModel.IsBusy), Mode=OneWay}" />
                <TextBlock AutomationProperties.AutomationId="StatusText"
                    AutomationProperties.LiveSetting="Polite" Grid.Column="1" TextWrapping="Wrap"
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </Grid>
        </Grid>
    </Grid>
</Page>

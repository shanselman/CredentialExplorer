<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CredentialExplorer.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CredentialExplorer"
    xmlns:core="using:CredentialExplorer.Core">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1000" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DetailColumn.Width" Value="360" />
                        <Setter Target="DetailRow.Height" Value="0" />
                        <Setter Target="DetailPanel.(Grid.Row)" Value="0" />
                        <Setter Target="DetailPanel.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <NavigationView x:Name="StoreNavigation"
            AutomationProperties.AutomationId="StoreNavigation"
            PaneDisplayMode="Top" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
            IsPaneToggleButtonVisible="False" SelectionChanged="StoreChanged"
            IsEnabled="{x:Bind ViewModel.IsInteractive, Mode=OneWay}">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="WindowsNavigation"
                    AutomationProperties.AutomationId="WindowsStore"
                    Content="{x:Bind ViewModel.WindowsLabel, Mode=OneWay}" Tag="Windows">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Permissions" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.AutomationId="WebStore"
                    Content="{x:Bind ViewModel.WebLabel, Mode=OneWay}" Tag="Web">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="World" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
        </NavigationView>
        <Grid Grid.Row="1" Padding="24,16,24,16" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock AutomationProperties.AutomationId="StoreHeading"
                        Text="{x:Bind ViewModel.Heading, Mode=OneWay}"
                        Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Explore saved sign-in metadata. Keep secrets in Windows."
                        TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox x:Name="ThemePicker" AutomationProperties.AutomationId="ThemePicker"
                    AutomationProperties.Name="App theme" Grid.Column="1" MinWidth="144"
                    Header="Theme" SelectedIndex="0" SelectionChanged="ThemeChanged">
                    <x:String>System default</x:String>
                    <x:String>Light</x:String>
                    <x:String>Dark</x:String>
                </ComboBox>
            </Grid>
            <InfoBar Grid.Row="1" AutomationProperties.AutomationId="ScopeNotice"
                IsOpen="True" IsClosable="False" Severity="Informational"
                Title="Store scope">
                <TextBlock AutomationProperties.AutomationId="ScopeText"
                    Margin="0,0,0,12" Text="{x:Bind ViewModel.ScopeNote, Mode=OneWay}" TextWrapping="Wrap" />
            </InfoBar>
            <InfoBar Grid.Row="2" AutomationProperties.AutomationId="StoreError"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False"
                Severity="Error" Title="Unable to access the store">
                <TextBlock AutomationProperties.AutomationId="ErrorText"
                    Margin="0,0,0,12" Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}" TextWrapping="Wrap" />
            </InfoBar>
            <Grid Grid.Row="3" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox AutomationProperties.AutomationId="CredentialSearch"
                    AutomationProperties.Name="Search credential metadata"
                    PlaceholderText="Search target, username, or type"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    IsEnabled="{x:Bind ViewModel.IsInteractive, Mode=OneWay}" />
                <ComboBox AutomationProperties.AutomationId="CredentialSort"
                    AutomationProperties.Name="Sort credentials" Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}"
                    IsEnabled="{x:Bind ViewModel.IsInteractive, Mode=OneWay}">
                    <x:String>Target: A to Z</x:String>
                    <x:String>Target: Z to A</x:String>
                    <x:String>Username</x:String>
                    <x:String>Type</x:String>
                    <x:String>Recently modified</x:String>
                </ComboBox>
                <Button AutomationProperties.AutomationId="RefreshCredentials"
                    AutomationProperties.Name="Refresh credential metadata"
                    Grid.Column="2" Command="{x:Bind ViewModel.RefreshCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Refresh" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </Grid>
            <Grid x:Name="MasterDetail" Grid.Row="4" ColumnSpacing="24" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="ListRow" Height="*" />
                    <RowDefinition x:Name="DetailRow" Height="280" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="DetailColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock AutomationProperties.AutomationId="CredentialCount"
                        AutomationProperties.LiveSetting="Polite"
                        Text="{x:Bind ViewModel.CountText, Mode=OneWay}"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ListView AutomationProperties.AutomationId="CredentialList"
                        AutomationProperties.Name="Credential metadata" Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                        ContainerContentChanging="CredentialContainerChanged"
                        IsEnabled="{x:Bind ViewModel.IsInteractive, Mode=OneWay}"
                        SelectionMode="Single" ShowsScrollingPlaceholders="True"
                        HorizontalContentAlignment="Stretch">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:CredentialMetadata">
                                <Grid Padding="4,8" RowSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{x:Bind Target}" TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind Target}"
                                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <Grid Grid.Row="1" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind DisplayUserName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind TypeName}"
                                            Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock AutomationProperties.AutomationId="EmptyState" Grid.Row="1"
                        Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" TextWrapping="Wrap"
                        Visibility="{x:Bind local:MainPage.Visible(ViewModel.ShowEmpty), Mode=OneWay}" />
                </Grid>
                <Border x:Name="DetailPanel" Grid.Row="1" Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Entry details" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Grid.Row="1" Text="Select an entry to see the metadata Windows supplies."
                            TextWrapping="Wrap"
                            Visibility="{x:Bind local:MainPage.Hidden(ViewModel.HasSelection), Mode=OneWay}" />
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                            Visibility="{x:Bind local:MainPage.Visible(ViewModel.HasSelection), Mode=OneWay}">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Target / resource" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock AutomationProperties.AutomationId="DetailTarget"
                                        Text="{x:Bind ViewModel.DetailTarget, Mode=OneWay}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Username" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock AutomationProperties.AutomationId="DetailUserName"
                                        Text="{x:Bind ViewModel.DetailUserName, Mode=OneWay}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Type" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock AutomationProperties.AutomationId="DetailType"
                                        Text="{x:Bind ViewModel.DetailType, Mode=OneWay}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Modified (local time)" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock AutomationProperties.AutomationId="DetailModified"
                                        Text="{x:Bind ViewModel.DetailModified, Mode=OneWay}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Persistence" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.DetailPersistence, Mode=OneWay}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.DetailRemovalNote, Mode=OneWay}" TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                        <Button AutomationProperties.AutomationId="RemoveCredential" Grid.Row="2"
                            Content="Remove entry..." Command="{x:Bind ViewModel.RemoveCommand}"
                            HorizontalAlignment="Stretch" />
                    </Grid>
                </Border>
            </Grid>
            <Grid Grid.Row="5" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ProgressRing Width="20" Height="20"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Visibility="{x:Bind local:MainPage.Visible(ViewModel.IsBusy), Mode=OneWay}" />
                <TextBlock AutomationProperties.AutomationId="StatusText"
                    AutomationProperties.LiveSetting="Polite" Grid.Column="1" TextWrapping="Wrap"
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
